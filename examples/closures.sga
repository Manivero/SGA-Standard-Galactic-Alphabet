// Замыкания: фабрика функций, IIFE и вызов через переменную
 make_multiplier(factor) {
     (x) {  x * factor; };
}

 double = make_multiplier(2);
 triple = make_multiplier(3);
("double(5) =", double(5));
("triple(5) =", triple(5));

// Немедленный вызов анонимной функции (IIFE)
("IIFE:", (a, b) {  a + b; }(10, 32));

// Замыкание, захватывающее переменную по значению
 total = 100;
 snapshot = () {  total; };
total = 999;
("snapshot всё ещё видит старое значение:", snapshot());
