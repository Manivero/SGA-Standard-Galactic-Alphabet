// std/process: args() — аргументы командной строки программы (T012)
//
// Запуск:  sga run examples/args.sga один "два слова" --флаг
// Всё, что стоит после пути файла, попадает в массив args() дословно —
// в том числе пустые строки и то, что выглядит как флаги. Путь к самой
// программе в args() НЕ входит. Без аргументов массив пуст.
 a = args();
("аргументов:", len(a));
 i  0..len(a) {
    ("  [" + to_string(i) + "] =", a[i]);
}
 len(a) == 0 {
    ("подсказка: sga run examples/args.sga привет мир");
}
