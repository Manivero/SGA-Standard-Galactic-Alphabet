// std/io: read_line() / read_stdin() — чтение стандартного ввода (T013)
//
// Запуск (ввод через pipe):
//   printf 'Тема: привет\nАвтор: Аня\n\nПервая строка тела\nВторая' | sga run examples/stdin.sga
// или интерактивно: вводите строки, пустая строка заканчивает «заголовки»,
// конец ввода — Ctrl-D (в Windows — Ctrl-Z и Enter).
//
// read_line() — следующая строка БЕЗ завершающего перевода строки ("\n" и
// "\r\n" отбрасываются). Когда ввод закончился, возвращает nil; пустая
// строка "" — настоящая пустая строка, а не конец ввода.
// read_stdin() — весь остаток ввода одной строкой, дословно ("" — если
// читать уже нечего).
//
// Пример читает «заголовки» — строки до первой пустой, — а остаток ввода
// забирает целиком как «тело». Без ввода (stdin пуст или закрыт) обе
// части пусты, и пример печатает подсказку.
 headers = 0;
  {
     line = read_line();
     line ==  {
        ;
    }
     line == "" {
        ;
    }
    headers = headers + 1;
    ("заголовок:", line);
}
 body = read_stdin();
("заголовков:", headers);
("тело:", len(body), "символов");
 headers == 0 {
    ("подсказка: printf 'Тема: привет\\n\\nтекст' | sga run examples/stdin.sga");
}
