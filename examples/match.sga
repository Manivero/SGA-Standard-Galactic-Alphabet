// MATCH-выражение: pattern matching с литералами и catch-all (T006)
 day = 3;
 day_name =  day {
    1 -> "понедельник",
    2 -> "вторник",
    3 -> "среда",
    4 -> "четверг",
    5 -> "пятница",
    6 -> "суббота",
    7 -> "воскресенье",
    _ -> "некорректный день"
};
("день", day, "=", day_name);

// Bind-паттерн: если ни один литерал не подошёл, значение доступно
// под собственным именем в теле catch-all-arm'а
 describe(n) {
      n {
        0 -> "ноль",
        1 -> "один",
        -1 -> "минус один",
        n -> "какое-то другое число: " + to_string(n)
    };
}
(describe(0));
(describe(1));
(describe(-1));
(describe(42));

// MATCH — выражение: используется прямо в арифметике/аргументах, без
// временной переменной, и arm'ы могут быть вложенным MATCH
 http_status_text(code) {
      code {
        200 -> "OK",
        404 -> "Not Found",
        500 -> "Internal Server Error",
        code -> "код " + to_string(code) + ": неизвестный статус"
    };
}
(http_status_text(200));
(http_status_text(404));
(http_status_text(999));

// Пример вложенного MATCH: сначала различаем чётность, затем — знак.
// ВАЖНО: catch-all обязателен ВСЕГДА, даже когда паттерны выглядят
// исчерпывающими (true/false для bool) — MATCH не анализирует домен
// значений scrutinee статически (динамическая типизация), поэтому
// компилятор требует явный '_' в любом случае.
 classify(n) {
      n % 2 {
        0 ->  n < 0 {
             -> "чётное отрицательное",
             -> "чётное неотрицательное",
            _ -> "недостижимо"
        },
        _ -> "нечётное"
    };
}
(-4, "->", classify(-4));
(3, "->", classify(3));
(6, "->", classify(6));
