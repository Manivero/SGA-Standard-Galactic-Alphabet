// Условия и логические операторы
 age = 20;
 age >= 18  age < 65 {
    ("взрослый трудоспособного возраста");
}   age < 18 {
    ("несовершеннолетний");
}  {
    ("пенсионный возраст");
}

 is_admin = ;
 is_owner = ;
 is_admin  is_owner {
    ("доступ разрешён");
}
