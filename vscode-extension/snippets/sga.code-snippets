{
	"let": {
		"prefix": "let",
		"body": " ${1:name} = ${2:value};",
		"description": "LET (immutable) — SGA-кодпоинты"
	},
	"var": {
		"prefix": "var",
		"body": " ${1:name} = ${2:value};",
		"description": "VAR (mutable) — SGA-кодпоинты"
	},
	"fn": {
		"prefix": "fn",
		"body": [
			" ${1:name}(${2:params}) {",
			"\t$0",
			"}"
		],
		"description": "FN — объявление функции"
	},
	"fnmut": {
		"prefix": "fnmut",
		"body": [
			" ${1:name}( ${2:param}) {",
			"\t$0",
			"}"
		],
		"description": "FN с MUT-параметром (Ownership/Borrowing) — вызывающая сторона обязана передать VAR-переменную"
	},
	"if": {
		"prefix": "if",
		"body": [
			" ${1:cond} {",
			"\t$0",
			"}"
		],
		"description": "IF"
	},
	"ifelse": {
		"prefix": "ifelse",
		"body": [
			" ${1:cond} {",
			"\t$2",
			"}  {",
			"\t$0",
			"}"
		],
		"description": "IF / ELSE"
	},
	"while": {
		"prefix": "while",
		"body": [
			" ${1:cond} {",
			"\t$0",
			"}"
		],
		"description": "WHILE"
	},
	"for": {
		"prefix": "for",
		"body": [
			" ${1:i}  ${2:0}..${3:10} {",
			"\t$0",
			"}"
		],
		"description": "FOR ... IN ... .. ..."
	},
	"print": {
		"prefix": "print",
		"body": "(${1:value});",
		"description": "PRINT"
	},
	"return": {
		"prefix": "return",
		"body": " ${1:value};",
		"description": "RETURN"
	},
	"match": {
		"prefix": "match",
		"body": [
			" ${1:scrutinee} {",
			"\t${2:pattern} -> ${3:expr},",
			"\t_ -> $0",
			"}"
		],
		"description": "MATCH ... { паттерн -> выражение, ..., _ -> ... }"
	}
}
