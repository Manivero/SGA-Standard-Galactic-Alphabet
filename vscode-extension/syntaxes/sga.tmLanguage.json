{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SGA",
	"scopeName": "source.sga",
	"fileTypes": [
		"sga"
	],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#sga-control-keywords"
		},
		{
			"include": "#sga-declaration-keywords"
		},
		{
			"include": "#sga-logical-keywords"
		},
		{
			"include": "#sga-literal-keywords"
		},
		{
			"include": "#sga-builtin-print"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#function-call"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.sga",
					"match": "//.*$"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.sga",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.sga",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.sga",
					"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
				}
			]
		},
		"sga-control-keywords": {
			"comment": "IF ELSE WHILE FOR IN BREAK CONTINUE RETURN — закодированы UCSUR Unicode PUA U+EB40..U+EB59, см. docs/SGA_ALPHABET.md",
			"patterns": [
				{
					"name": "keyword.control.conditional.sga",
					"match": ""
				},
				{
					"name": "keyword.control.conditional.sga",
					"match": ""
				},
				{
					"name": "keyword.control.loop.sga",
					"match": ""
				},
				{
					"name": "keyword.control.loop.sga",
					"match": ""
				},
				{
					"name": "keyword.control.loop.sga",
					"match": ""
				},
				{
					"name": "keyword.control.loop.sga",
					"match": ""
				},
				{
					"name": "keyword.control.loop.sga",
					"match": ""
				},
				{
					"name": "keyword.control.flow.sga",
					"match": ""
				},
				{
					"name": "keyword.control.match.sga",
					"match": ""
				}
			]
		},
		"sga-declaration-keywords": {
			"comment": "LET VAR CONST FN STRUCT MUT IMPORT",
			"patterns": [
				{
					"name": "storage.modifier.immutable.sga",
					"match": ""
				},
				{
					"name": "storage.modifier.mutable.sga",
					"match": ""
				},
				{
					"name": "storage.modifier.const.sga",
					"match": ""
				},
				{
					"name": "storage.type.function.sga",
					"match": ""
				},
				{
					"name": "storage.type.struct.sga",
					"match": ""
				},
				{
					"name": "storage.modifier.mut.sga",
					"match": ""
				},
				{
					"name": "keyword.control.import.sga",
					"match": ""
				}
			]
		},
		"sga-logical-keywords": {
			"comment": "AND OR NOT",
			"patterns": [
				{
					"name": "keyword.operator.logical.sga",
					"match": ""
				},
				{
					"name": "keyword.operator.logical.sga",
					"match": ""
				},
				{
					"name": "keyword.operator.logical.sga",
					"match": ""
				}
			]
		},
		"sga-literal-keywords": {
			"comment": "TRUE FALSE NIL",
			"patterns": [
				{
					"name": "constant.language.boolean.sga",
					"match": ""
				},
				{
					"name": "constant.language.boolean.sga",
					"match": ""
				},
				{
					"name": "constant.language.nil.sga",
					"match": ""
				}
			]
		},
		"sga-builtin-print": {
			"patterns": [
				{
					"name": "support.function.builtin.sga",
					"match": ""
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.sga",
					"match": "="
				},
				{
					"name": "keyword.operator.comparison.sga",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.arithmetic.sga",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.range.sga",
					"match": "\\.\\."
				},
				{
					"name": "keyword.operator.arrow.sga",
					"match": "->"
				},
				{
					"name": "punctuation.separator.sga",
					"match": "[,;:]"
				},
				{
					"name": "punctuation.brackets.sga",
					"match": "[\\(\\)\\{\\}\\[\\]]"
				}
			]
		},
		"function-call": {
			"patterns": [
				{
					"match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"name": "entity.name.function.sga"
				},
				{
					"match": "[A-Za-z_][A-Za-z0-9_]*",
					"name": "variable.other.sga"
				}
			]
		}
	}
}
