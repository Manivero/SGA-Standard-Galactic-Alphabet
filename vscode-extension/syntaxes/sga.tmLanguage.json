{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SGA",
  "scopeName": "source.sga",
  "fileTypes": ["sga"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#sga-control-keywords" },
    { "include": "#sga-declaration-keywords" },
    { "include": "#sga-logical-keywords" },
    { "include": "#sga-literal-keywords" },
    { "include": "#sga-builtin-print" },
    { "include": "#operators" },
    { "include": "#function-call" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sga",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sga",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.sga", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sga",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "sga-control-keywords": {
      "comment": "IF ELSE WHILE FOR IN BREAK CONTINUE RETURN — закодированы UCSUR Unicode PUA U+EB40..U+EB59, см. docs/SGA_ALPHABET.md",
      "patterns": [
        { "name": "keyword.control.conditional.sga", "match": "\uEB48\uEB45" },
        { "name": "keyword.control.conditional.sga", "match": "\uEB44\uEB4B\uEB52\uEB44" },
        { "name": "keyword.control.loop.sga", "match": "\uEB56\uEB47\uEB48\uEB4B\uEB44" },
        { "name": "keyword.control.loop.sga", "match": "\uEB45\uEB4E\uEB51" },
        { "name": "keyword.control.loop.sga", "match": "\uEB48\uEB4D" },
        { "name": "keyword.control.loop.sga", "match": "\uEB41\uEB51\uEB44\uEB40\uEB4A" },
        { "name": "keyword.control.loop.sga", "match": "\uEB42\uEB4E\uEB4D\uEB53\uEB48\uEB4D\uEB54\uEB44" },
        { "name": "keyword.control.flow.sga", "match": "\uEB51\uEB44\uEB53\uEB54\uEB51\uEB4D" }
      ]
    },
    "sga-declaration-keywords": {
      "comment": "LET VAR CONST FN STRUCT MUT IMPORT",
      "patterns": [
        { "name": "storage.modifier.immutable.sga", "match": "\uEB4B\uEB44\uEB53" },
        { "name": "storage.modifier.mutable.sga", "match": "\uEB55\uEB40\uEB51" },
        { "name": "storage.modifier.const.sga", "match": "\uEB42\uEB4E\uEB4D\uEB52\uEB53" },
        { "name": "storage.type.function.sga", "match": "\uEB45\uEB4D" },
        { "name": "storage.type.struct.sga", "match": "\uEB52\uEB53\uEB51\uEB54\uEB42\uEB53" },
        { "name": "storage.modifier.mut.sga", "match": "\uEB4C\uEB54\uEB53" },
        { "name": "keyword.control.import.sga", "match": "\uEB48\uEB4C\uEB4F\uEB4E\uEB51\uEB53" }
      ]
    },
    "sga-logical-keywords": {
      "comment": "AND OR NOT",
      "patterns": [
        { "name": "keyword.operator.logical.sga", "match": "\uEB40\uEB4D\uEB43" },
        { "name": "keyword.operator.logical.sga", "match": "\uEB4E\uEB51" },
        { "name": "keyword.operator.logical.sga", "match": "\uEB4D\uEB4E\uEB53" }
      ]
    },
    "sga-literal-keywords": {
      "comment": "TRUE FALSE NIL",
      "patterns": [
        { "name": "constant.language.boolean.sga", "match": "\uEB53\uEB51\uEB54\uEB44" },
        { "name": "constant.language.boolean.sga", "match": "\uEB45\uEB40\uEB4B\uEB52\uEB44" },
        { "name": "constant.language.nil.sga", "match": "\uEB4D\uEB48\uEB4B" }
      ]
    },
    "sga-builtin-print": {
      "patterns": [
        { "name": "support.function.builtin.sga", "match": "\uEB4F\uEB51\uEB48\uEB4D\uEB53" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.sga", "match": "=" },
        { "name": "keyword.operator.comparison.sga", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.sga", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.range.sga", "match": "\\.\\." },
        { "name": "keyword.operator.arrow.sga", "match": "->" },
        { "name": "punctuation.separator.sga", "match": "[,;:]" },
        { "name": "punctuation.brackets.sga", "match": "[\\(\\)\\{\\}\\[\\]]" }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.sga"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.sga"
        }
      ]
    }
  }
}
