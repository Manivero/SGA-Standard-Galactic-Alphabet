// std/time: time_now_ms() / time_monotonic_ms() — время (T014)
//
// Запуск:  sga run examples/time.sga
//
// time_now_ms() — КАЛЕНДАРНОЕ время: миллисекунды с 1970-01-01T00:00:00Z
// (эпоха Unix, UTC) по системным часам — «метка времени» для логов и для
// сравнения с другими системами. Системные часы можно перевести (вручную или
// синхронизацией времени), поэтому разность двух таких меток НЕ годится для
// замера интервалов.
// time_monotonic_ms() — МОНОТОННОЕ время: миллисекунды с момента запуска VM.
// Не убывает и не зависит от перевода системных часов — для замера интервалов
// берите разность двух вызовов.
//
// Оба результата — int (целые миллисекунды, округление вниз). Вывод этого
// примера зависит от времени и от машины: от запуска к запуску меняются и
// метка, и длительность.
let stamp = time_now_ms();
print("метка времени (мс с 1970-01-01 UTC):", stamp);

let started = time_monotonic_ms();
var total = 0;
for i in 0..200000 {
    total = total + i;
}
let finished = time_monotonic_ms();
print("сумма:", total);
print("цикл занял, мс:", finished - started);
if finished >= started {
    print("монотонные часы не убывают");
}
