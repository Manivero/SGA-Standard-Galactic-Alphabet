// std/io: write_file(path, content) — запись файлов с явным разрешением (T015)
//
// Запуск:  sga run --allow-write examples/write_file.sga
//
// Запись ЗАПРЕЩЕНА по умолчанию: без флага --allow-write (он обязан стоять ДО
// имени файла) эта программа завершится ошибкой, ничего не создав. Разрешение
// выдаёт только пользователь при запуске — сама программа, манифест и
// окружение выдать его не могут.
//
// Путь, как у read_file, относителен каталогу ЭТОГО файла (write_file.sga) и
// не может выйти за его пределы — ни через абсолютный путь, ни через "..", ни
// через symlink. Каталоги write_file НЕ создаёт: data/ уже существует. Файл
// создаётся или ПЕРЕЗАПИСЫВАЕТСЯ целиком; текст пишется как есть, перевод
// строки в конце — на вашей совести ("\n"). Результат вызова — nil.
let path = "data/written_by_example.txt";

write_file(path, "первая запись\n");
print("после первой записи:", read_file(path));

write_file(path, "вторая\n");
print("после второй записи (первая перезаписана целиком):", read_file(path));
